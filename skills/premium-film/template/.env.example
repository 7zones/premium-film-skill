# Copy to .env (git-ignored, mode 600) and fill in what you have. Every key is optional; never print or commit them.
# Run tools/providers.py after any change: it checks each key and picks the newest model for each job.

# Preferred: OpenRouter (openrouter.ai) — one key reaches Gemini for reviews and narration and GPT Image 2 for images,
# with a spend limit you set on the key.
OPENROUTER_API_KEY=
# Gemini API (aistudio.google.com) — the free tier alone is enough for narration and reviews (about 10 voice
# requests per model per day).
GEMINI_API_KEY=
# Optional: ElevenLabs (elevenlabs.io) — more narrator voices to audition.
ELEVENLABS_API_KEY=
